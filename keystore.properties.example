# إعدادات توقيع إصدار الإنتاج (Release / Google Play App Signing Upload Key)
# ملاحظة أمنية: لا تضع كلمات المرور الحقيقية في هذا الملف المثال.
# ملف المفتاح (my-upload-key.jks) محمي في .gitignore.

storeFile=my-upload-key.jks
keyAlias=upload
storePassword=YOUR_SECURE_STORE_PASSWORD
keyPassword=YOUR_SECURE_KEY_PASSWORD

# بيانات الشهادة الثابتة (لا تتغير بين الإصدارات):
# Key Algorithm: RSA 4096-bit
# Signature Algorithm: SHA256withRSA
# Validity: 36500 days (100 years: 2026-11-07 -> 2126-10-14)
# SHA-1: 49:4D:1F:98:50:93:96:92:16:97:15:32:E0:6B:40:2D:AB:C7:CB:82
# SHA-256: 7B:D1:3A:E2:EE:63:E7:5C:02:76:C5:41:E7:3F:20:C2:3D:56:32:BF:CE:5F:B9:07:D5:E1:0E:7F:2C:CC:B3:3B
